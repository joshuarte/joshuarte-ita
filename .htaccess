RewriteEngine On

# Se il file o la directory richiesta non esiste fisicamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Reindirizza le richieste senza estensione alla versione .html
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Opzionale: gestisci anche le sottodirectory
RewriteRule ^([^\.]+)/([^\.]+)$ $1/$2.html [NC,L] 