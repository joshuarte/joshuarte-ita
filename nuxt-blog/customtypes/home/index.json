{
  "format": "page",
  "id": "home",
  "label": "Home",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "intro_title": {
        "type": "Text",
        "config": {
          "label": "Titolo Introduttivo",
          "placeholder": "Es. Joshua Rte."
        }
      },
      "intro_text": {
        "type": "StructuredText",
        "config": {
          "label": "Testo Introduttivo",
          "placeholder": "Descrizione breve",
          "allowTargetBlank": true,
          "single": "paragraph"
        }
      },
      "intro_button": {
        "type": "Link",
        "config": {
          "label": "Pulsante Introduttivo",
          "placeholder": "Link al pulsante",
          "allowTargetBlank": true,
          "allowText": true
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "home": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
